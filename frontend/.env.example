VITE_LEGACY_SITE_URL=https://englishine.vercel.app

# Local development: leave VITE_API_URL unset. Vite proxies /api to
# http://127.0.0.1:3001 so the browser stays same-origin and HttpOnly cookies work
# on both http://127.0.0.1:5173 and http://localhost:5173.
# VITE_API_URL=http://127.0.0.1:3001/api/v1

# Production: leave VITE_API_URL unset at build time so the SPA calls
# same-origin /api/v1. vercel.json rewrites /api/:path* to Northflank and
# keeps the /api/... path. VITE_API_URL is baked into the JavaScript bundle;
# rebuild after changing it.
#
# Only set an absolute VITE_API_URL if the API is on a different origin. Then
# the backend must use COOKIE_SAME_SITE=none, COOKIE_SECURE=true, and
# CORS_ORIGINS must include the exact SPA origin.
# VITE_API_URL=https://www.example.com/api/v1
