{
  "name": "englishine-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready API foundation for the Englishine learning platform.",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "prisma generate && eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "tsx --test tests/*.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/lib-storage": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/jwt": "10.2.2",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "dotenv": "17.4.2",
    "fastify": "5.12.4",
    "fastify-plugin": "6.0.0",
    "file-type": "^22.1.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "eslint": "10.10.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
