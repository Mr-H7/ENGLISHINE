  courseId          String?                    @db.Uuid
  unitId            String?                    @db.Uuid
  lessonId          String?                    @db.Uuid
  productId         String?                    @db.Uuid
  maxUses           Int                        @default(1)
  usedCount         Int                        @default(0)
  expiresAt         DateTime?                  @db.Timestamptz(3)
  status            ActivationCodeStatus       @default(ACTIVE)
  assignedStudentId String?                    @db.Uuid
  createdById       String                     @db.Uuid
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @db.Timestamptz(3)
  assignedStudent   StudentProfile?            @relation("ActivationCodeAssignedStudent", fields: [assignedStudentId], references: [id])
  course            Course?                    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy         User                       @relation("ActivationCodeCreatedBy", fields: [createdById], references: [id])
  lesson            Lesson?                    @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  product           Product?                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit              CourseUnit?                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  redemptions       ActivationCodeRedemption[]

  @@index([status, expiresAt])
  @@index([courseId])
  @@index([unitId])
  @@index([lessonId])
  @@index([productId])
  @@index([assignedStudentId])
  @@index([createdById])
}

model ActivationCodeRedemption {
  id               String         @id @default(uuid()) @db.Uuid
  activationCodeId String         @db.Uuid
  studentId        String         @db.Uuid
  redeemedAt       DateTime       @default(now()) @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  activationCode   ActivationCode @relation(fields: [activationCodeId], references: [id])
  student          StudentProfile @relation(fields: [studentId], references: [id])

  @@unique([activationCodeId, studentId])
  @@index([studentId, redeemedAt])
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorId    String?     @db.Uuid
  action     AuditAction
  entityType String      @db.VarChar(120)
  entityId   String?     @db.VarChar(120)
  before     Json?
  after      Json?
  ipAddress  String?     @db.Inet
  userAgent  String?
  requestId  String?     @db.VarChar(120)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(160)
  value       Json
  description String?  @db.VarChar(255)
  isPublic    Boolean  @default(false)
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedBy   User?    @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  @@index([isPublic])
  @@index([updatedById])
}

model ActivityLog {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String?      @db.Uuid
  type       ActivityType
  entityType String?      @db.VarChar(120)
  entityId   String?      @db.VarChar(120)
  metadata   Json?
  occurredAt DateTime     @default(now()) @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)
  user       User?        @relation(fields: [userId], references: [id])

  @@index([userId, occurredAt])
  @@index([type, occurredAt])
  @@index([entityType, entityId, occurredAt])
}

