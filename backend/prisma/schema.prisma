generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique @db.VarChar(320)
  passwordHash            String                   @db.VarChar(255)
  status                  UserStatus               @default(PENDING)
  emailVerifiedAt         DateTime?                @db.Timestamptz(3)
  lastLoginAt             DateTime?                @db.Timestamptz(3)
  deletedAt               DateTime?                @db.Timestamptz(3)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)
  activationCodesCreated  ActivationCode[]         @relation("ActivationCodeCreatedBy")
  activityLogs            ActivityLog[]
  adminProfile            AdminProfile?
  createdAnnouncements    Announcement[]           @relation("AnnouncementCreatedBy")
  reviewedAssignments     AssignmentSubmission[]   @relation("AssignmentReviewedBy")
  auditLogs               AuditLog[]               @relation("AuditActor")
  comments                Comment[]
  couponRedemptions       CouponRedemption[]
  createdCourses          Course[]                 @relation("CourseCreatedBy")
  deviceSessions          DeviceSession[]
  emailVerificationTokens EmailVerificationToken[]
  reviewedHomework        HomeworkSubmission[]     @relation("HomeworkReviewedBy")
  createdNotifications    Notification[]           @relation("NotificationCreatedBy")
  orders                  Order[]
  passwordResetTokens     PasswordResetToken[]
  privateBookingRequests  PrivateBooking[]         @relation("BookingRequestedBy")
  refreshTokens           RefreshToken[]
  settingsUpdated         Setting[]                @relation("SettingUpdatedBy")
  studentProfile          StudentProfile?
  teacherProfile          TeacherProfile?
  notificationRecipients  UserNotification[]
  roles                   UserRole[]
  wallet                  Wallet?

  @@index([status, deletedAt])
  @@index([createdAt])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         SystemRole       @unique
  name        String           @unique @db.VarChar(80)
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(true)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  roles       RolePermission[]
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model DeviceSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  deviceIdHash  String         @db.VarChar(255)
  deviceName    String?        @db.VarChar(120)
  userAgent     String?
  ipAddress     String?        @db.Inet
  lastSeenAt    DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime       @db.Timestamptz(3)
  revokedAt     DateTime?      @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([userId, deviceIdHash])
  @@index([userId, revokedAt, expiresAt])
}

model RefreshToken {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  deviceSessionId String?        @db.Uuid
  tokenHash       String         @unique @db.VarChar(255)
  familyId        String         @db.Uuid
  expiresAt       DateTime       @db.Timestamptz(3)
  revokedAt       DateTime?      @db.Timestamptz(3)
  replacedByHash  String?        @db.VarChar(255)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  deviceSession   DeviceSession? @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@index([deviceSessionId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model StudentProfile {
  id                    String                     @id @default(uuid()) @db.Uuid
  userId                String                     @unique @db.Uuid
  gradeId               String?                    @db.Uuid
  fullName              String                     @db.VarChar(160)
  parentName            String?                    @db.VarChar(160)
  parentPhone           String?                    @db.VarChar(32)
  birthDate             DateTime?                  @db.Date
  createdAt             DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                   @updatedAt @db.Timestamptz(3)
  assignedCodes         ActivationCode[]           @relation("ActivationCodeAssignedStudent")
  activationRedemptions ActivationCodeRedemption[]
  assignmentSubmissions AssignmentSubmission[]
  certificates          Certificate[]
  enrollments           CourseEnrollment[]
  examAttempts          ExamAttempt[]
  homeworkSubmissions   HomeworkSubmission[]
  liveAttendances       LiveSessionAttendance[]
  grade                 Grade?                     @relation(fields: [gradeId], references: [id])
  user                  User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gradeId])
  @@index([fullName])
}

model TeacherProfile {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @unique @db.Uuid
  fullName         String           @db.VarChar(160)
  title            String?          @db.VarChar(160)
  biography        String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  courses          CourseTeacher[]
  liveSessions     LiveSession[]
  assignedBookings PrivateBooking[] @relation("BookingAssignedTeacher")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  fullName  String   @db.VarChar(160)
  jobTitle  String?  @db.VarChar(160)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AcademicStage {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique @db.VarChar(40)
  nameAr        String         @db.VarChar(120)
  nameEn        String         @db.VarChar(120)
  sortOrder     Int            @unique
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  announcements Announcement[]
  grades        Grade[]
}

model Grade {
  id            String           @id @default(uuid()) @db.Uuid
  stageId       String           @db.Uuid
  code          String           @unique @db.VarChar(40)
  nameAr        String           @db.VarChar(120)
  nameEn        String           @db.VarChar(120)
  sortOrder     Int
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  academicTerms AcademicTerm[]
  announcements Announcement[]
  courses       Course[]
  stage         AcademicStage    @relation(fields: [stageId], references: [id])
  students      StudentProfile[]

  @@unique([stageId, sortOrder])
  @@index([stageId, isActive])
}

model AcademicTerm {
  id           String           @id @default(uuid()) @db.Uuid
  gradeId      String           @db.Uuid
  type         AcademicTermType
  academicYear String           @db.VarChar(20)
  startsAt     DateTime?        @db.Date
  endsAt       DateTime?        @db.Date
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  grade        Grade            @relation(fields: [gradeId], references: [id])
  courses      Course[]
  units        CourseUnit[]

  @@unique([gradeId, type, academicYear])
  @@index([academicYear, isActive])
}

model Course {
  id               String             @id @default(uuid()) @db.Uuid
  gradeId          String?            @db.Uuid
  academicTermId   String?            @db.Uuid
  createdById      String             @db.Uuid
  coverAssetId     String?            @unique @db.Uuid
  title            String             @db.VarChar(180)
  slug             String             @unique @db.VarChar(200)
  shortDescription String?            @db.VarChar(320)
  description      String?
  status           CourseStatus       @default(DRAFT)
  accessLevel      AccessLevel        @default(ENROLLED)
  publishedAt      DateTime?          @db.Timestamptz(3)
  deletedAt        DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  activationCodes  ActivationCode[]
  announcements    Announcement[]
  certificates     Certificate[]
  academicTerm     AcademicTerm?      @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  coverAsset       FileAsset?         @relation("CourseCover", fields: [coverAssetId], references: [id])
  createdBy        User               @relation("CourseCreatedBy", fields: [createdById], references: [id])
  grade            Grade?             @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  enrollments      CourseEnrollment[]
  teachers         CourseTeacher[]
  units            CourseUnit[]
  exams            Exam[]
  liveSessions     LiveSession[]
  productLinks     ProductCourse[]

  @@index([status, publishedAt])
  @@index([gradeId, academicTermId, status])
  @@index([createdById])
  @@index([deletedAt])
}

model CourseTeacher {
  courseId  String         @db.Uuid
  teacherId String         @db.Uuid
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id])

  @@id([courseId, teacherId])
  @@index([teacherId])
}

model CourseUnit {
  id              String           @id @default(uuid()) @db.Uuid
  courseId        String           @db.Uuid
  academicTermId  String?          @db.Uuid
  title           String           @db.VarChar(180)
  description     String?
  position        Int
  status          ContentStatus    @default(DRAFT)
  availableFrom   DateTime?        @db.Timestamptz(3)
  deletedAt       DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  activationCodes ActivationCode[]
  academicTerm    AcademicTerm?    @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons         Lesson[]
  productLinks    ProductUnit[]

  @@unique([courseId, position])
  @@index([courseId, status, position])
  @@index([academicTermId])
  @@index([deletedAt])
}

model Lesson {
  id                 String           @id @default(uuid()) @db.Uuid
  unitId             String           @db.Uuid
  title              String           @db.VarChar(180)
  description        String?
  position           Int
  status             ContentStatus    @default(DRAFT)
  accessLevel        AccessLevel      @default(ENROLLED)
  estimatedMinutes   Int?
  availableFrom      DateTime?        @db.Timestamptz(3)
  deletedAt          DateTime?        @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  activationCodes    ActivationCode[]
  assignments        Assignment[]
  comments           Comment[]
  lastCourseProgress CourseProgress[] @relation("CourseProgressLastLesson")
  exams              Exam[]
  homework           Homework[]
  unit               CourseUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  lessonProgress     LessonProgress[]
  resources          LessonResource[]
  productLinks       ProductLesson[]
  videos             Video[]

  @@unique([unitId, position])
  @@index([unitId, status, position])
  @@index([deletedAt])
}

model Video {
  id                  String               @id @default(uuid()) @db.Uuid
  lessonId            String               @db.Uuid
  fileAssetId         String?              @unique @db.Uuid
  thumbnailAssetId    String?              @db.Uuid
  title               String               @db.VarChar(180)
  type                VideoType
  status              ContentStatus        @default(DRAFT)
  accessLevel         AccessLevel          @default(LOCKED)
  position            Int
  durationSeconds     Int?
  externalProviderKey String?              @db.VarChar(255)
  availableFrom       DateTime?            @db.Timestamptz(3)
  deletedAt           DateTime?            @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  comments            Comment[]
  homeworkSolution    Homework?
  fileAsset           FileAsset?           @relation("VideoFile", fields: [fileAssetId], references: [id])
  lesson              Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  thumbnailAsset      FileAsset?           @relation("VideoThumbnail", fields: [thumbnailAssetId], references: [id])
  watchProgress       VideoWatchProgress[]

  @@unique([lessonId, position])
  @@index([lessonId, status, position])
  @@index([type, accessLevel])
  @@index([thumbnailAssetId])
  @@index([deletedAt])
}

model FileAsset {
  id                    String                 @id @default(uuid()) @db.Uuid
  storageProvider       String                 @db.VarChar(60)
  storageKey            String                 @unique @db.VarChar(512)
  originalName          String                 @db.VarChar(255)
  mimeType              String                 @db.VarChar(160)
  byteSize              BigInt
  checksum              String?                @db.VarChar(128)
  isPublic              Boolean                @default(false)
  metadata              Json?
  deletedAt             DateTime?              @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  assignmentSubmissions AssignmentSubmission[]
  certificates          Certificate[]
  courseCover           Course?                @relation("CourseCover")
  lessonResources       LessonResource[]
  videoFile             Video?                 @relation("VideoFile")
  videoThumbnails       Video[]                @relation("VideoThumbnail")

  @@index([mimeType])
  @@index([deletedAt])
}

model LessonResource {
  id         String       @id @default(uuid()) @db.Uuid
  lessonId   String       @db.Uuid
  assetId    String       @db.Uuid
  title      String       @db.VarChar(180)
  type       ResourceType
  position   Int          @default(0)
  isDownload Boolean      @default(false)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)
  asset      FileAsset    @relation(fields: [assetId], references: [id])
  lesson     Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, assetId])
  @@index([lessonId, position])
  @@index([assetId])
}

model CourseEnrollment {
  id             String               @id @default(uuid()) @db.Uuid
  studentId      String               @db.Uuid
  courseId       String               @db.Uuid
  orderItemId    String?              @unique @db.Uuid
  status         EnrollmentStatus     @default(PENDING)
  source         EnrollmentSource
  startsAt       DateTime?            @db.Timestamptz(3)
  expiresAt      DateTime?            @db.Timestamptz(3)
  completedAt    DateTime?            @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)
  course         Course               @relation(fields: [courseId], references: [id])
  orderItem      OrderItem?           @relation(fields: [orderItemId], references: [id])
  student        StudentProfile       @relation(fields: [studentId], references: [id])
  courseProgress CourseProgress?
  lessonProgress LessonProgress[]
  videoProgress  VideoWatchProgress[]

  @@unique([studentId, courseId])
  @@index([courseId, status])
  @@index([studentId, status, expiresAt])
}

model Homework {
  id              String               @id @default(uuid()) @db.Uuid
  lessonId        String               @db.Uuid
  solutionVideoId String?              @unique @db.Uuid
  title           String               @db.VarChar(180)
  instructions    String?
  status          HomeworkStatus       @default(DRAFT)
  maxScore        Decimal?             @db.Decimal(8, 2)
  dueAt           DateTime?            @db.Timestamptz(3)
  deletedAt       DateTime?            @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  lesson          Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  solutionVideo   Video?               @relation(fields: [solutionVideoId], references: [id])
  questions       HomeworkQuestion[]
  submissions     HomeworkSubmission[]

  @@index([lessonId, status])
  @@index([dueAt])
  @@index([deletedAt])
}

model HomeworkQuestion {
  id          String           @id @default(uuid()) @db.Uuid
  homeworkId  String           @db.Uuid
  type        QuestionType
  prompt      String
  position    Int
  points      Decimal?         @db.Decimal(8, 2)
  correctText String?
  explanation String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  answers     HomeworkAnswer[]
  choices     HomeworkChoice[]
  homework    Homework         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, position])
  @@index([homeworkId])
}

model HomeworkChoice {
  id         String           @id @default(uuid()) @db.Uuid
  questionId String           @db.Uuid
  label      String
  position   Int
  isCorrect  Boolean          @default(false)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)
  answers    HomeworkAnswer[]
  question   HomeworkQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
}

model HomeworkSubmission {
  id           String           @id @default(uuid()) @db.Uuid
  homeworkId   String           @db.Uuid
  studentId    String           @db.Uuid
  reviewedById String?          @db.Uuid
  attemptNo    Int              @default(1)
  status       SubmissionStatus @default(NOT_STARTED)
  reviewStatus ReviewStatus     @default(PENDING)
  submittedAt  DateTime?        @db.Timestamptz(3)
  reviewedAt   DateTime?        @db.Timestamptz(3)
  score        Decimal?         @db.Decimal(8, 2)
  feedback     String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  answers      HomeworkAnswer[]
  homework     Homework         @relation(fields: [homeworkId], references: [id])
  reviewedBy   User?            @relation("HomeworkReviewedBy", fields: [reviewedById], references: [id])
  student      StudentProfile   @relation(fields: [studentId], references: [id])

  @@unique([homeworkId, studentId, attemptNo])
  @@index([studentId, status])
  @@index([homeworkId, reviewStatus, submittedAt])
  @@index([reviewedById])
}

model HomeworkAnswer {
  id               String             @id @default(uuid()) @db.Uuid
  submissionId     String             @db.Uuid
  questionId       String             @db.Uuid
  selectedChoiceId String?            @db.Uuid
  textAnswer       String?
  awardedPoints    Decimal?           @db.Decimal(8, 2)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  question         HomeworkQuestion   @relation(fields: [questionId], references: [id])
  selectedChoice   HomeworkChoice?    @relation(fields: [selectedChoiceId], references: [id])
  submission       HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([questionId])
  @@index([selectedChoiceId])
}

model Assignment {
  id           String                 @id @default(uuid()) @db.Uuid
  lessonId     String                 @db.Uuid
  title        String                 @db.VarChar(180)
  instructions String?
  status       ContentStatus          @default(DRAFT)
  dueAt        DateTime?              @db.Timestamptz(3)
  maxScore     Decimal?               @db.Decimal(8, 2)
  deletedAt    DateTime?              @db.Timestamptz(3)
  createdAt    DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(3)
  lesson       Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions  AssignmentSubmission[]

  @@index([lessonId, status])
  @@index([dueAt])
  @@index([deletedAt])
}

model AssignmentSubmission {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @db.Uuid
  studentId    String           @db.Uuid
  assetId      String?          @db.Uuid
  reviewedById String?          @db.Uuid
  attemptNo    Int              @default(1)
  textAnswer   String?
  status       SubmissionStatus @default(NOT_STARTED)
  reviewStatus ReviewStatus     @default(PENDING)
  submittedAt  DateTime?        @db.Timestamptz(3)
  reviewedAt   DateTime?        @db.Timestamptz(3)
  score        Decimal?         @db.Decimal(8, 2)
  feedback     String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  asset        FileAsset?       @relation(fields: [assetId], references: [id])
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  reviewedBy   User?            @relation("AssignmentReviewedBy", fields: [reviewedById], references: [id])
  student      StudentProfile   @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId, attemptNo])
  @@index([studentId, status])
  @@index([assignmentId, reviewStatus, submittedAt])
  @@index([assetId])
  @@index([reviewedById])
}

model Exam {
  id                String         @id @default(uuid()) @db.Uuid
  courseId          String         @db.Uuid
  lessonId          String?        @db.Uuid
  title             String         @db.VarChar(180)
  instructions      String?
  status            ExamStatus     @default(DRAFT)
  durationMinutes   Int?
  maxAttempts       Int            @default(1)
  passingPercentage Decimal?       @db.Decimal(5, 2)
  opensAt           DateTime?      @db.Timestamptz(3)
  closesAt          DateTime?      @db.Timestamptz(3)
  publishedAt       DateTime?      @db.Timestamptz(3)
