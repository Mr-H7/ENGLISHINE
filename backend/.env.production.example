# Production contract. Copy into the host secret store, not into git.
# Fill every empty value. Never reuse local development credentials.

NODE_ENV=production
APP_NAME=englishine-api
# Bind loopback when a reverse proxy on the same machine terminates TLS.
# On Vercel, PORT is injected and listen() is intercepted; HOST is unused there.
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Required when nginx/Caddy/Vercel sits in front of Fastify. Vercel also sets VERCEL=1.
TRUST_PROXY=true

# PostgreSQL. Use a production user and database. Do not dump local QA data here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/englishine?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/englishine?schema=public

# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
COOKIE_NAME=englishine_refresh
ACCESS_COOKIE_NAME=englishine_access
COOKIE_SECURE=true
# Same-origin reverse proxy (recommended): lax
# Cross-origin API on a different site: none (also requires COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax

# Public HTTPS origin of the SPA (same Vercel URL in multi-service mode). Never *.
CORS_ORIGINS=https://www.example.com

BODY_LIMIT_BYTES=1048576
# Used as local staging only when STORAGE_DRIVER=r2. Still required for STORAGE_DRIVER=local.
# On Vercel the filesystem is ephemeral; use R2 and /tmp, never local disk as media storage.
UPLOAD_DIR=/var/lib/englishine/uploads
UPLOAD_MAX_FILE_BYTES=2147483648
MATERIAL_MAX_FILE_BYTES=26214400
UPLOAD_MAX_FILES=5

# Explicit driver. Do not infer R2 from NODE_ENV.
# r2: admin uploads go browser → presigned PUT → Fastify finalize (bypasses Vercel 4.5 MB).
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=englishine-media
R2_ENDPOINT=

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# One-time Super Admin bootstrap only. Keep these in the secret store, not the SPA.
# Unset them after npm run bootstrap:admin succeeds.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
