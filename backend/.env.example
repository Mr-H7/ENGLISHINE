# Local development defaults. Copy to backend/.env (never commit .env).
# Production values belong in host secrets / backend/.env.production.example.

# Runtime
NODE_ENV=development
APP_NAME=englishine-api
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
TRUST_PROXY=false

# PostgreSQL
# DATABASE_URL is used by the running application. DIRECT_URL is used by Prisma CLI migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/englishine?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/englishine?schema=public

# Authentication — replace with at least 32 random characters outside local development.
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
COOKIE_NAME=englishine_refresh
ACCESS_COOKIE_NAME=englishine_access
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Local-only admin bootstrap: npm run bootstrap:admin
# Do not commit real passwords. Copy these into a one-shot shell environment, not git.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=

# Comma-separated browser origins. Never use * with credentials in production.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Request and upload limits (bytes)
BODY_LIMIT_BYTES=1048576
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_FILE_BYTES=2147483648
MATERIAL_MAX_FILE_BYTES=26214400
UPLOAD_MAX_FILES=5

# local (default) uses UPLOAD_DIR. r2 requires the R2_* variables below.
STORAGE_DRIVER=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=englishine-media
# R2_ENDPOINT=

# Abuse protection
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
