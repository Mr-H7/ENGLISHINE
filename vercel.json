{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastify",
      "buildCommand": "npm run bundle:vercel",
      "entrypoint": "src/server.mjs",
      "functions": {
        "src/server.mjs": {
          "includeFiles": "../node_modules/{argon2,node-gyp-build,@phc/format,pg}/**"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
