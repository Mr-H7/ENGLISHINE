{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastify",
      "buildCommand": "npm run bundle:vercel",
      "entrypoint": "src/server.cjs",
      "functions": {
        "src/server.cjs": {
          "includeFiles": "englishine-app.mjs"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
