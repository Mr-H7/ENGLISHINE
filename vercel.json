{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastify",
      "buildCommand": "npm run bundle:vercel",
      "entrypoint": "src/server.mjs",
      "functions": {
        "src/server.mjs": {
          "includeFiles": "{../node_modules/argon2/**,../node_modules/node-gyp-build/**,../node_modules/@phc/format/**,../node_modules/pg/**,../node_modules/pg-types/**,../node_modules/pg-pool/**,../node_modules/pg-protocol/**,../node_modules/pg-connection-string/**,../node_modules/pgpass/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
